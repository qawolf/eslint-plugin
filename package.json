{
  "dependencies": {
    "@denis-sokolov/eslint-plugin": "^19.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/compat": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@typescript-eslint/utils": "^8.46.0",
    "eslint-plugin-github": "^5.1.8 <6.0.0",
    "eslint-plugin-import": "github:qawolf/eslint-plugin-import#prefer-top-level-if-only-type-imports",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-no-await-in-promise": "^2.0.1",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-redos": "^4.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@qawolf/cycle-import-check": "^1.4.0-003",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/strictest": "^2.0.6",
    "@types/eslint": "^8.56.12",
    "@types/node": "^22.18.9",
    "@typescript-eslint/rule-tester": "^8.62.1",
    "ava": "^6.4.1",
    "eslint": "^9.39.4",
    "prettier": "^3.6.2",
    "publint": "^0.3.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "license": "ISC",
  "name": "@qawolf/eslint-plugin",
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "prettier": {},
  "repository": "github:qawolf/eslint-plugin",
  "scripts": {
    "build": "rm -rf dist && NODE_ENV=production tsc",
    "build:watch": "npm run build -- --watch",
    "lint": "cycle-import-scan . && prettier --check --log-level=warn . && publint --strict",
    "lint:fix": "cycle-import-scan . && prettier --log-level=warn --write .",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify && npm run build",
    "test": "ava",
    "test:watch": "ava --watch",
    "tsc:check": "tsc --noEmit",
    "verify": "npm run tsc:check && npm run lint && npm run test"
  },
  "type": "commonjs",
  "version": "20.2.1"
}
